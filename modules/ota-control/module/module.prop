id=gxr_ota_control
name=Galaxy XR OTA Control
version=0.1.0
versionCode=1
author=4uva4ek
description=Stops Galaxy XR firmware updates by disabling com.wssyncmldm and com.sec.android.soagent for user 0 and setting ota_disable_automatic_update=1, and restores each of the three to the value recorded in a baseline taken before the first block. Writes persistent system state, not process RAM. Ships disabled; Action reports status and recovery.
updateJson=https://raw.githubusercontent.com/4uva4ek/galaxyxr-modules/main/updates/ota-control.json
